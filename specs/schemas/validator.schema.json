{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
  	"$id": "https://typcast.local/schemas/validation.schema.json",
	"type": "object",
	"required": ["version", "page", "contents"],
	"properties": {
		"version": {
			"type": "string",
			"pattern": "^\\d+\\.\\d+\\.\\d+$"
		},
		"page": {
			"type": "object",
			"properties": {
				"paper": { 
					"type": "object",
					"properties": {
						"paper": { "$ref": "./api/types/paper.schema.json" },
						"margin": { "$ref": "./definitions/bound.schema.json" }
					}
				}
			}
		},
		"modules": {
			"type": "object",
			"required": ["name"],
			"properties": {
				"name": { "type": "string" },
				"exports": { 
					"type": "array",
					"items": { 
						"type": "string",
						"default": "*"
					}
				}
			}
		},
		"contents": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"call": { "$ref": "./definitions/node.schema.json" }
				}
			}
		}
	}
}