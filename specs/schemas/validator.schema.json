{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zuudevs/typcast/v1.0.0/specs/schemas/validator.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "author": {
          "type": "string",
          "maxLength": 512
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "paper": {
          "$ref": "./api/types/paper.schema.json"
        },
        "orientation": {
          "type": "string",
          "enum": [
            "portrait",
            "landscape"
          ]
        },
        "margin": {
          "$ref": "./definitions/bound.schema.json"
        }
      },
      "required": [
        "paper",
        "orientation",
        "margin"
      ],
      "additionalProperties": false
    },
    "contents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./definitions/node.schema.json"
      }
    },
    "modules": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "alias": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        },
        "required": [
          "path"
        ],
        "not": {
          "required": [
            "alias",
            "items"
          ]
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "metadata",
    "page",
    "contents"
  ],
  "additionalProperties": false
}
