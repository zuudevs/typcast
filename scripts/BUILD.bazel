load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(
    default_visibility = ["//visibility:public"],
)

# The version check of the release gate. The library is separate so that the
# unit tests import it.
py_library(
    name = "check_version_lib",
    srcs = [
        "__init__.py",
        "check_version.py",
    ],
    imports = ["."],
)

py_binary(
    name = "check_version",
    srcs = [
        "check_version.py",
    ],
    main = "check_version.py",
    data = ["//:release_manifests"],
)

# The documents that the checks read. The group lives in the root package so
# that a new document is a deliberate addition to the gate.
py_test(
    name = "docs_checks",
    size = "small",
    srcs = [
        "__init__.py",
        "validate_docs.py",
    ],
    main = "validate_docs.py",
    data = [
        "//:docs_sources",
        "//:workflow_sources",
        "//specs/schemas:BUILD.bazel",
        "//specs/schemas:validator.schema.json",
        "//specs/schemas/definitions:bound.schema.json",
        "//specs/schemas/definitions:node.schema.json",
        "//specs/schemas/templates/api/types:alignment.schema.json.tmpl",
        "//specs/schemas/templates/api/types:length.schema.json.tmpl",
        "//specs/schemas/templates/api/types:paper.schema.json.tmpl",
    ],
)
