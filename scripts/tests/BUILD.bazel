load("@rules_python//python:defs.bzl", "py_test")

package(
    default_visibility = ["//visibility:public"],
)

py_test(
    name = "version_tests",
    size = "small",
    srcs = [
        "__init__.py",
        "test_check_version.py",
    ],
    main = "test_check_version.py",
    data = ["//:release_manifests"],
    deps = [
        "//scripts:check_version_lib",
    ],
)

py_test(
    name = "docs_tests",
    size = "small",
    srcs = [
        "__init__.py",
        "test_validate_docs.py",
    ],
    main = "test_validate_docs.py",
    deps = [
        "//scripts:docs_lib",
    ],
)

py_test(
    name = "link_tests",
    size = "small",
    srcs = [
        "__init__.py",
        "test_check_links.py",
    ],
    main = "test_check_links.py",
    deps = [
        "//scripts:docs_lib",
        "//scripts:check_links_lib",
    ],
)

py_test(
    name = "release_tests",
    size = "small",
    srcs = [
        "__init__.py",
        "test_prepare_release.py",
    ],
    main = "test_prepare_release.py",
    deps = [
        "//scripts:prepare_release_lib",
    ],
)

# The rehearsal of the release commit. It uses the manifests, the schema
# sources, and the bundle of the build, so that the path of the release lane
# runs in every test lane.
py_test(
    name = "release_flow_tests",
    size = "small",
    srcs = [
        "__init__.py",
        "test_release_flow.py",
    ],
    main = "test_release_flow.py",
    data = [
        "//:release_manifests",
        "//specs/schemas:schema_bundle",
        "//specs/schemas:schema_manifest",
    ],
    deps = [
        "//scripts:prepare_release_lib",
    ],
)
