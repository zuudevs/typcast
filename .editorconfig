root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Trailing double spaces are meaningful in Markdown (hard line breaks), so
# trailing whitespace is not trimmed in documentation.
trim_trailing_whitespace = false

[*.{json,yml,yaml,toml,csv}]
indent_size = 2

[*.bazel]
indent_size = 4

[Makefile]
indent_style = tab

[LICENSE]
# The Apache-2.0 license text is reproduced verbatim.
insert_final_newline = true
trim_trailing_whitespace = false
