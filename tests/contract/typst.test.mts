/**
 * Cross-language contract checks for the Typst emitter.
 *
 * The shared fixtures under `tests/fixtures/` are the single source of truth
 * of the contract. This runner reads the document manifest and checks that the
 * TypeScript SDK:
 *
 * - emits the source that the golden file holds for every valid document,
 *   byte for byte,
 * - emits the same source when it emits the same document twice,
 * - writes the output with the encoding and the line endings of the output
 *   contract.
 *
 * The Python runner `tests/contract/test_typst.py` reads the same manifest
 * and the same golden files, so a drift in either SDK fails one of the two
 * contract targets.
 */

import { existsSync, readFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

import { Document } from "../../packages/typescript/lib/src/index.js";

const MANIFEST_NAME = "manifest.json";
const DOCUMENTS_DIRECTORY = "documents";
const EXPECTED_DIRECTORY = "expected";

interface ValidEntry {
  readonly file: string;
}

interface Manifest {
  readonly valid: readonly ValidEntry[];
}

function hasManifest(directory: string): boolean {
  try {
    readFileSync(join(directory, MANIFEST_NAME), "utf-8");
    return true;
  } catch {
    return false;
  }
}

function findFixtureRoot(): string {
  const candidates: string[] = [];
  const runfiles = process.env["RUNFILES_DIR"];
  const workspace = process.env["TEST_WORKSPACE"] ?? "_main";
  if (runfiles !== undefined) {
    candidates.push(join(runfiles, workspace, "tests", "fixtures"));
    candidates.push(join(runfiles, "tests", "fixtures"));
  }
  let current = dirname(fileURLToPath(import.meta.url));
  for (;;) {
    candidates.push(join(current, "tests", "fixtures"));
    const parent = dirname(current);
    if (parent === current) {
      break;
    }
    current = parent;
  }
  candidates.push(join(process.cwd(), "tests", "fixtures"));
  for (const candidate of candidates) {
    if (hasManifest(join(candidate, DOCUMENTS_DIRECTORY))) {
      return candidate;
    }
  }
  throw new Error("document fixtures not found; run the target through Bazel");
}

function loadManifest(root: string): Manifest {
  const text = readFileSync(
    join(root, DOCUMENTS_DIRECTORY, MANIFEST_NAME),
    "utf-8",
  );
  const value: unknown = JSON.parse(text);
  if (typeof value !== "object" || value === null) {
    throw new Error("the document manifest must be a JSON object");
  }
  const record = value as Record<string, unknown>;
  return { valid: record["valid"] as readonly ValidEntry[] };
}

/** Returns the name of the golden file of a document fixture. */
function expectedName(documentName: string): string {
  const stem = documentName.replace(/\.json$/, "");
  return `${stem}.typ`;
}

function readDocument(root: string, name: string): Document {
  const text = readFileSync(join(root, DOCUMENTS_DIRECTORY, name), "utf-8");
  return Document.fromJSON(JSON.parse(text) as unknown);
}

const failures: string[] = [];

function check(condition: boolean, message: string): void {
  if (!condition) {
    failures.push(message);
  }
}

function main(): void {
  const root = findFixtureRoot();
  const manifest = loadManifest(root);

  for (const entry of manifest.valid) {
    const golden = join(root, EXPECTED_DIRECTORY, expectedName(entry.file));
    if (!existsSync(golden)) {
      failures.push(`${entry.file}: the golden file must exist`);
      continue;
    }
    const bytes = readFileSync(golden);
    const expected = readFileSync(golden, "utf-8");
    const document = readDocument(root, entry.file);
    const source = document.toTypst();
    if (source !== expected) {
      failures.push(
        `${entry.file}: the emitted source must match the golden file byte for byte\n` +
          `--- actual ---\n${source}\n--- expected ---\n${expected}`,
      );
    }
    if (document.toTypst() !== source) {
      failures.push(`${entry.file}: the same document must produce the same source`);
    }
    if (
      bytes.length >= 3 &&
      bytes[0] === 0xef &&
      bytes[1] === 0xbb &&
      bytes[2] === 0xbf
    ) {
      failures.push(`${entry.file}: the output must hold no byte order mark`);
    }
    if (bytes.includes(0x0d)) {
      failures.push(`${entry.file}: the line endings must be LF`);
    }
    if (bytes[bytes.length - 1] !== 0x0a) {
      failures.push(`${entry.file}: the output must end with a newline`);
    }
    if (bytes.length >= 2 && bytes[bytes.length - 2] === 0x0a) {
      failures.push(`${entry.file}: the output ends with exactly one newline`);
    }
    if (!source.startsWith("// Generated by Typcast. Do not edit.\n")) {
      failures.push(`${entry.file}: the output starts with the header of the contract`);
    }
  }

  if (failures.length > 0) {
    for (const failure of failures) {
      console.error(`ERROR ${failure}`);
    }
    console.error(`failures: ${failures.length}`);
    process.exit(1);
    return;
  }
  console.log(`valid documents: ${manifest.valid.length}`);
  console.log("failures: 0");
}

main();
