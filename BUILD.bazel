package(
    default_visibility = ["//visibility:public"],
)

# The TypeScript ruleset reads its compiler version from this manifest.
exports_files([
    "package.json",
])

# The workflow files. The repository checks read them to enforce the action
# pinning and the permissions of every workflow.
filegroup(
    name = "workflow_sources",
    srcs = glob(
        [
            ".github/workflows/*.yaml",
            ".github/workflows/*.yml",
        ],
        allow_empty = True,
    ),
)

# The manifests that carry the version of the release. The release gate
# compares them with the tag and with the changelog. The schema sources are
# part of the group because their identity names the contract version.
filegroup(
    name = "release_manifests",
    srcs = [
        "CHANGELOG.md",
        "MODULE.bazel",
        "package.json",
        "//packages/python:pyproject.toml",
        "//packages/typescript:package.json",
        "//specs/schemas:validator.schema.json",
        "//specs/schemas/definitions:bound.schema.json",
        "//specs/schemas/definitions:node.schema.json",
        "//specs/schemas/templates/api/types:alignment.schema.json.tmpl",
        "//specs/schemas/templates/api/types:length.schema.json.tmpl",
        "//specs/schemas/templates/api/types:paper.schema.json.tmpl",
    ],
)

# The documents that the repository checks read. The group keeps the list in
# one place so that a new document is a deliberate addition to the gate.
filegroup(
    name = "docs_sources",
    srcs = glob([
        ".editorconfig",
        ".gitattributes",
        ".github/CODEOWNERS",
        ".github/PULL_REQUEST_TEMPLATE.md",
        "CHANGELOG.md",
        "CODE_OF_CONDUCT.md",
        "CONTRIBUTING.md",
        "LICENSE",
        "README.md",
        "SECURITY.md",
        "docs/**/*.md",
    ]),
)
