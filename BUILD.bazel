package(
    default_visibility = ["//visibility:public"],
)

# The TypeScript ruleset reads its compiler version from this manifest.
exports_files([
    "package.json",
])

# The documents that the repository checks read. The group keeps the list in
# one place so that a new document is a deliberate addition to the gate.
filegroup(
    name = "docs_sources",
    srcs = glob([
        ".editorconfig",
        ".gitattributes",
        ".github/PULL_REQUEST_TEMPLATE.md",
        "LICENSE",
        "README.md",
        "SECURITY.md",
        "docs/**/*.md",
    ]),
)
