load("@rules_python//python:defs.bzl", "py_test")

package(
    default_visibility = ["//visibility:public"],
)

# The unit tests of the immutable document model.
py_test(
    name = "model_tests",
    size = "small",
    srcs = [
        "test_models.py",
    ],
    main = "test_models.py",
    deps = [
        "//packages/python:typcast",
    ],
)

# The unit tests of the validation engine.
py_test(
    name = "validation_tests",
    size = "small",
    srcs = [
        "test_validation.py",
    ],
    main = "test_validation.py",
    deps = [
        "//packages/python:typcast",
    ],
)

# The unit tests of the fluent builder.
py_test(
    name = "builder_tests",
    size = "small",
    srcs = [
        "test_builder.py",
    ],
    main = "test_builder.py",
    deps = [
        "//packages/python:typcast",
    ],
)
