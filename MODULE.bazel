
module(
    name = "typcast",
    version = "0.1.0",
)

# Python
bazel_dep(
    name = "rules_python",
    version = "2.5.1",
)

python = use_extension(
    "@rules_python//python/extensions:python.bzl",
    "python",
)

python.defaults(
    python_version = "3.14",
)

python.toolchain(
    python_version = "3.14",
)

# JavaScript / Node.js
bazel_dep(
    name = "aspect_rules_js",
    version = "3.6.1",
)

# TypeScript
bazel_dep(
    name = "aspect_rules_ts",
    version = "3.10.1",
)

typescript = use_extension(
    "@aspect_rules_ts//ts:extensions.bzl",
    "typescript",
    dev_dependency = True,
)

typescript.deps(
    version_from = "//:package.json",
)

use_repo(
    typescript,
    "npm_typescript",
)
